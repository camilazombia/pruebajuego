# Copia este archivo como .env.local para desarrollo local
# En Vercel, configura estas variables en el dashboard (Settings > Environment Variables)

# MongoDB - mismo cluster, base de datos "mundo-magico"
MONGODB_URI=mongodb+srv://USER:PASS@plataforma-ingles.qfk2o.mongodb.net/mundo-magico?retryWrites=true&w=majority&appName=plataforma-ingles

# NextAuth - IMPORTANTE: NEXTAUTH_URL debe ser la URL exacta de tu deploy en Vercel
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://tu-proyecto.vercel.app

# JWT auxiliar
JWT_SECRET=

# URLs públicas - deben coincidir con tu dominio en Vercel
NEXT_PUBLIC_BASE_URL=https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# IA Chatbot
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Stripe — Pagos
# Los montos ($200k, $90k, $130k, $690k COP) están hardcodeados en el código.
# Solo necesitas estas dos claves — no hay price IDs que configurar.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
